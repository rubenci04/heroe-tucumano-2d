[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://cf07dcbdrqkvm"]

[ext_resource type="Script" uid="uid://blvxioxthw8lh" path="res://scripts/data/dialogue_sequence.gd" id="1"]

[resource]
script = ExtResource("1")
sequence_id = &"demo_ending_acheral"
entries = Array[Dictionary]([{
"speaker": "Hincha de San Martín",
"text": "¡Se terminó el chamuyo, Palermitano! ¡Soltá a la Campeona!"
}, {
"speaker": "El Palermitano",
"text": "Esto fue apenas una validación de mercado. Nos replegamos al Ingenio La Providencia con la Campeona."
}, {
"speaker": "Hincha de San Martín",
"text": "¡Voy detrás de ustedes! Esto no termina hasta traerla de vuelta."
}, {
"speaker": "El Palermitano",
"text": "Considérenlo una pausa estratégica. Próximo destino: Ingenio La Providencia."
}])
