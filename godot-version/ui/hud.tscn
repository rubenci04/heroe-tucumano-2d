[sub_resource type="Shader" id="HeatSunTransparencyShader"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 tint = COLOR;\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat distance_from_white = distance(source.rgb, vec3(1.0));\n\tfloat alpha_mask = smoothstep(0.04, 0.18, distance_from_white);\n\tCOLOR = vec4(source.rgb, source.a * alpha_mask) * tint;\n}\n"

[sub_resource type="ShaderMaterial" id="HeatSunMaterial"]
